# ════════════════════════════════════════════════════════════════════════════
# Streaming Live RAG — Environment Configuration
# Copy this file to .env and fill in your keys.
# ════════════════════════════════════════════════════════════════════════════

# ── Primary LLM: Google Gemini (default) ────────────────────────────────────
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (LiteLLM format). Options:
#   gemini/gemini-2.5-flash   ← recommended (fastest, lowest cost)
#   gemini/gemini-1.5-flash   ← stable fallback
#   gemini/gemini-1.5-pro     ← highest quality
LLM_MODEL=gemini/gemini-2.5-flash

# ── Fallback LLM: OpenAI ─────────────────────────────────────────────────────
# Set LLM_MODEL=gpt-4o or gpt-4o-mini to use this provider instead
# OPENAI_API_KEY=your_openai_api_key_here

# ── Fallback LLM: Groq (ultra-fast inference) ────────────────────────────────
# Set LLM_MODEL=groq/llama-3.3-70b-versatile to use this provider
# GROQ_API_KEY=your_groq_api_key_here

# ── Retrieval Configuration ───────────────────────────────────────────────────
# Number of candidates from dense + sparse before RRF fusion
RETRIEVAL_TOP_K=20
# Final top-K chunks passed to synthesizer after reranking
RERANK_TOP_K=5
# RRF rank-fusion constant (default 60, higher = smoother fusion)
RRF_K=60
# Minimum cross-encoder score to be included (prevents low-quality evidence)
RERANK_SCORE_THRESHOLD=-2.0

# ── Embedding Model ───────────────────────────────────────────────────────────
EMBED_MODEL=all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── ChromaDB ──────────────────────────────────────────────────────────────────
# Set to "memory" for ephemeral (testing) or a path for persistence
CHROMA_MODE=persist
CHROMA_PATH=./data/chroma_db
CHROMA_COLLECTION=rag_corpus

# ── Stability Detection ────────────────────────────────────────────────────────
# Minimum content token count to trigger RETRIEVE (below → WAIT)
MIN_CONTENT_TOKENS=5
# Confidence threshold below which stability check uses LLM instead of heuristics
STABILITY_LLM_THRESHOLD=0.6

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_DIR=./logs
LOG_FILE=events.jsonl

# ?? Nvidia NIM LLM
NVIDIA_NIM_API_KEY=your_nvidia_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
